{
  "name": "niker-pet-matcher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "eval:chat:offline": "CHAT_EVAL_WRITE_REPORT=1 vitest run tests/chat-extraction-eval.test.ts --reporter=verbose",
    "eval:chat:model": "GEMINI_EVAL_LIVE=1 node --env-file=.env.local ./node_modules/vitest/vitest.mjs run tests/gemini-model-eval.test.ts --reporter=verbose",
    "eval:chat:criteria": "GEMINI_EVAL_CRITERIA=1 node --env-file=.env.local ./node_modules/vitest/vitest.mjs run tests/gemini-criteria-eval.test.ts --reporter=verbose",
    "eval:chat:model:score": "node evals/score-chat-model-report.mjs",
    "eval:chat:live": "node --env-file=.env.local evals/run-chat-live.mjs",
    "eval:parser:export": "node --env-file=.env.local evals/export-animal-parser-review.mjs",
    "eval:parser:score": "node evals/score-animal-parser-review.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@supabase/supabase-js": "^2.49.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.6",
    "openai": "^4.86.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.0.5"
  }
}
