# Without these values the app intentionally runs in the clearly labelled demo mode.
# Gemini Free Tier: obtain a key in Google AI Studio. Never expose it in the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional legacy provider. Gemini takes precedence when both keys are present.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to animalsss for the imported text-based animal catalog; defaults to animals.
SUPABASE_ANIMALS_TABLE=animals
# Optional. Use only on the server; needed for protected admin operations.
SUPABASE_SERVICE_ROLE_KEY=
# Set a long, unique password before enabling admin login.
ADMIN_PASSWORD=
