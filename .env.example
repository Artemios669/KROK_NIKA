# Without these values the app intentionally runs in the clearly labelled demo mode.
# Gemini Free Tier: obtain a key in Google AI Studio. Never expose it in the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional legacy provider. Gemini takes precedence when both keys are present.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Use only on the server; needed for protected admin operations.
SUPABASE_SERVICE_ROLE_KEY=
# Set a long random password before enabling the demo admin login.
ADMIN_PASSWORD=
